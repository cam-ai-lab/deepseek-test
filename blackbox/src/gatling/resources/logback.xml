<?xml version="1.0" encoding="UTF-8"?>
<!-- Without this file Logback falls back to DEBUG, and Testcontainers, Netty and docker-java flood the
     log with tens of thousands of lines. Gatling's own console summary is printed regardless. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.gatling" level="WARN"/>
    <logger name="org.testcontainers" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
