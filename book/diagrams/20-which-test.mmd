flowchart TB
    Q1{"Is it pure logic<br/>(no I/O)?"} -- yes --> U["Unit test"]
    Q1 -- no --> Q2{"Is the risk in how our code<br/>talks to ONE technology?<br/>(SQL, HTTP, JSON)"}
    Q2 -- yes --> I["Integration / slice test<br/>with the real technology"]
    Q2 -- no --> Q3{"Is the risk in the agreement<br/>with another team?"}
    Q3 -- yes --> C["Contract test"]
    Q3 -- no --> Q4{"Is the risk in the assembled,<br/>deployed product?"}
    Q4 -- yes --> B["Black-box scenario"]
    Q4 -- no --> Q5{"Is it about speed<br/>or capacity?"}
    Q5 -- yes --> P["Performance test"]
    Q5 -- no --> R["Rethink: what could<br/>actually go wrong?"]
